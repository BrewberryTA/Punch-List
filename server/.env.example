# Copy this to .env (already gitignored) and fill in your own key.
# Without ANTHROPIC_API_KEY set, the app still runs end-to-end — it just
# drafts placeholder items via processing/stub.ts instead of real ones.

# From https://console.anthropic.com — needs billing enabled.
ANTHROPIC_API_KEY=

# Optional — defaults to 4000.
# PORT=4000
